{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "status", "review_mode", "verdict", "session_id", "reviewed_head", "completed_at", "criteria", "blocker"],
  "properties": {
    "phase": { "type": "string", "enum": ["reviewer"] },
    "status": { "type": "string", "enum": ["completed"] },
    "review_mode": { "type": "string", "enum": ["criteria", "final"] },
    "verdict": { "type": "string", "enum": ["approved", "changes_requested", "blocked"] },
    "session_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "reviewed_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "completed_at": { "type": "string", "minLength": 1 },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "finding"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC[1-9][0-9]*$" },
          "status": { "type": "string", "enum": ["passed", "failed"] },
          "finding": { "type": "string" }
        }
      }
    },
    "blocker": { "type": "string" }
  }
}
